<?xml version="1.0"?>
<robot name="premium_scara_robot">

  <!-- Industrial Color Palette -->
  <material name="graphite"><color rgba="0.15 0.15 0.18 1.0"/></material>
  <material name="pure_white"><color rgba="0.94 0.94 0.96 1.0"/></material>
  <material name="metallic_silver"><color rgba="0.75 0.78 0.82 1.0"/></material>
  <material name="accent_blue"><color rgba="0.05 0.45 0.85 1.0"/></material>
  <material name="gripper_dark"><color rgba="0.25 0.25 0.28 1.0"/></material>
  <material name="gold_tip"><color rgba="0.9 0.7 0.1 1.0"/></material>

  <!-- ==================== 1. BASE LINK ==================== -->
  <link name="base_link">
    <visual>
      <geometry><cylinder length="0.04" radius="0.18"/></geometry>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <material name="graphite"/>
    </visual>
    <visual>
      <geometry><cylinder length="0.30" radius="0.11"/></geometry>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <material name="pure_white"/>
    </visual>
    <visual>
      <geometry><cylinder length="0.03" radius="0.12"/></geometry>
      <origin xyz="0 0 0.32" rpy="0 0 0"/>
      <material name="accent_blue"/>
    </visual>
  </link>

  <!-- ==================== JOINT 1: SHOULDER ==================== -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.335" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20.0" velocity="2.5"/>
  </joint>

  <!-- Link 1: Upper Arm -->
  <link name="link_1">
    <visual>
      <geometry><cylinder length="0.12" radius="0.11"/></geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <material name="pure_white"/>
    </visual>
    <visual>
      <geometry><cylinder length="0.02" radius="0.08"/></geometry>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <material name="graphite"/>
    </visual>
    <visual>
      <geometry><box size="0.34 0.15 0.09"/></geometry>
      <origin xyz="0.17 0 0.065" rpy="0 0 0"/>
      <material name="pure_white"/>
    </visual>
    <visual>
      <geometry><cylinder length="0.10" radius="0.09"/></geometry>
      <origin xyz="0.34 0 0.065" rpy="0 0 0"/>
      <material name="pure_white"/>
    </visual>
  </link>

  <!-- ==================== JOINT 2: ELBOW (SAFE COLLISION-FREE LIMIT) ==================== -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.34 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.1" upper="2.1" effort="15.0" velocity="2.0"/>
  </joint>

  <!-- Link 2: Forearm -->
  <link name="link_2">
    <visual>
      <geometry><cylinder length="0.10" radius="0.085"/></geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="graphite"/>
    </visual>
    <visual>
      <geometry><box size="0.28 0.12 0.08"/></geometry>
      <origin xyz="0.14 0 0.05" rpy="0 0 0"/>
      <material name="pure_white"/>
    </visual>
    <visual>
      <geometry><cylinder length="0.16" radius="0.07"/></geometry>
      <origin xyz="0.28 0 0.08" rpy="0 0 0"/>
      <material name="accent_blue"/>
    </visual>
  </link>

  <!-- ==================== JOINT 3: Z-AXIS QUILL ==================== -->
  <joint name="joint_3" type="prismatic">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.28 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.18" upper="0.05" effort="20.0" velocity="1.0"/>
  </joint>

  <!-- Link 3: Stainless Steel Shaft -->
  <link name="link_3">
    <visual>
      <geometry><cylinder length="0.40" radius="0.015"/></geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="metallic_silver"/>
    </visual>
    <visual>
      <geometry><cylinder length="0.02" radius="0.03"/></geometry>
      <origin xyz="0 0 -0.14" rpy="0 0 0"/>
      <material name="graphite"/>
    </visual>
  </link>

  <!-- ==================== JOINT 4: FULL 360° CONTINUOUS ROTATION ==================== -->
  <joint name="joint_4" type="continuous">
    <parent link="link_3"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Gripper with Two Fingers -->
  <link name="gripper_base">
    <visual>
      <geometry><box size="0.08 0.04 0.03"/></geometry>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <material name="gripper_dark"/>
    </visual>
    <!-- Finger 1 (Left) -->
    <visual>
      <geometry><box size="0.015 0.01 0.05"/></geometry>
      <origin xyz="0.025 0.02 -0.045" rpy="0 0 0"/>
      <material name="pure_white"/>
    </visual>
    <visual>
      <geometry><box size="0.018 0.012 0.012"/></geometry>
      <origin xyz="0.025 0.02 -0.07" rpy="0 0 0"/>
      <material name="gold_tip"/>
    </visual>
    <!-- Finger 2 (Right) -->
    <visual>
      <geometry><box size="0.015 0.01 0.05"/></geometry>
      <origin xyz="0.025 -0.02 -0.045" rpy="0 0 0"/>
      <material name="pure_white"/>
    </visual>
    <visual>
      <geometry><box size="0.018 0.012 0.012"/></geometry>
      <origin xyz="0.025 -0.02 -0.07" rpy="0 0 0"/>
      <material name="gold_tip"/>
    </visual>
  </link>

</robot>
